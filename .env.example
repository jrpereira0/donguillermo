# Copie para .env.local e preencha. NUNCA commite o .env.local.

# --- Supabase (Project Settings > API) ---
# Project URL, ex.: https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# anon / publishable key (pública por design; quem protege os dados é a RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL da aplicação em desenvolvimento
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- SEGREDO (somente servidor) ---
# service_role / secret key. IGNORA a RLS. Necessária a partir da Etapa 5
# (convite de usuários). Cole só no .env.local, nunca em chat, e-mail ou Git.
SUPABASE_SERVICE_ROLE_KEY=

# --- Banco (opcional) ---
# String de conexão Postgres para `npm run db:migrate` aplicar as migrations.
# Supabase > Connect > "Session pooler" (substitua [YOUR-PASSWORD]). Segredo!
# Sem isso, use `npm run db:bundle` e cole o SQL no SQL Editor.
SUPABASE_DB_URL=

# --- Administrador da rede ---
# E-mail do primeiro acesso (usado no seed da Etapa 2)
ADMIN_EMAIL=
# (opcional) senha inicial do admin no `npm run db:seed`. Se vazio, a conta nasce
# sem senha e você define a sua em "Esqueci minha senha" na tela de login.
ADMIN_INITIAL_PASSWORD=
