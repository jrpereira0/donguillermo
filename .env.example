# Copie para .env.local e preencha. NUNCA commite o .env.local.

# --- Supabase (Project Settings > API) ---
# Project URL, ex.: https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# anon / publishable key (pública por design; quem protege os dados é a RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL da aplicação em desenvolvimento
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- SEGREDO (somente servidor) ---
# service_role / secret key. IGNORA a RLS. Necessária a partir da Etapa 5
# (convite de usuários). Cole só no .env.local, nunca em chat, e-mail ou Git.
SUPABASE_SERVICE_ROLE_KEY=

# --- Administrador da rede ---
# E-mail do primeiro acesso (usado no seed da Etapa 2)
ADMIN_EMAIL=
