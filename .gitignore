# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (segredos ficam FORA do Git; só o .env.example é versionado)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# gerados localmente (contêm credenciais de teste / SQL consolidado)
.dev-credentials.local.md
supabase/_bundle.sql

# log do servidor de dev rodando em segundo plano
dev-server.log

# capturas de tela dos testes ponta a ponta que falharam
.e2e-artifacts/
